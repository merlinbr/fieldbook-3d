# Local media is served separately with npm run media:dev.
# Development mode defaults to this URL; production requires an external HTTP(S) URL.
# This public build-time value must contain no credentials or secrets.
PUBLIC_ANKYLOSAURUS_MODEL_URL=http://127.0.0.1:5194/ankylosaurus.glb

# Optional full English recording metadata, not an audio URL alone.
# Approved source: docs/assets/ankylosaurus-narration.en.json
# Serialize that entire object; local PowerShell setup and complete schema:
# docs/assets/ankylosaurus-narration.md#configure-the-approved-recording
# PUBLIC_ANKYLOSAURUS_STUDY_VERSION is public build-time data: no secrets,
# URL credentials, signed query tokens, or private billing evidence.
# Missing configuration leaves Start disabled; there are no default timings.
PUBLIC_ANKYLOSAURUS_STUDY_VERSION=

# Optional complete German recording metadata with independent duration/cues/captions.
# Absent German data uses the visibly identified English version in the German UI.
# Invalid configured data and media errors remain explicit; neither silently switches audio.
PUBLIC_ANKYLOSAURUS_STUDY_VERSION_DE=
