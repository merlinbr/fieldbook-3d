{
  "name": "fieldbook-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "imports": { "#lib/*": "./src/lib/*" },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node tools/paraglide.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:camera": "node checks/camera-fit.mjs && node checks/scale-comparison.mjs",
    "check:anatomy": "node checks/anatomy-regions.mjs && node checks/anatomy-input.mjs && node checks/anatomy-inspection.mjs",
    "check:study": "node checks/viewer-study.mjs && node checks/field-study.mjs && node checks/study-presentation.mjs && node checks/study-dust.mjs",
    "check:stegosaurus": "node checks/stegosaurus.mjs",
    "export:stegosaurus": "node tools/export-stegosaurus.mjs",
    "check:stegosaurus-export": "node checks/stegosaurus-export.mjs",
    "check:media": "node checks/dev-media.mjs",
    "preview:stegosaurus": "vite --config tools/stegosaurus-preview/vite.config.js",
    "build:stegosaurus": "vite build --config tools/stegosaurus-preview/vite.config.js",
    "media:dev": "node tools/serve-dev-media.mjs"
  },
  "dependencies": { "three": "0.186.1" },
  "devDependencies": {
    "@inlang/paraglide-js": "2.25.4",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/three": "^0.185.0",
    "svelte": "^5.56.7",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
